    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:'Segoe UI',sans-serif;
            scroll-behavior:smooth;
        }

        body{
            background:#0d1117;
            color:#ffffff;
            line-height:1.6;
        }

        /* NAVBAR */

        .navbar{
            position:fixed;
            top:0;
            width:100%;
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:20px 60px;
            background:#161b22;
            border-bottom:1px solid #30363d;
            z-index:1000;
        }

        .logo{
            font-size:24px;
            font-weight:bold;
            color:#58a6ff;
        }

        .nav-links{
            list-style:none;
            display:flex;
            gap:30px;
        }

        .nav-links a{
            text-decoration:none;
            color:white;
            transition:0.3s;
            font-size:16px;
        }

        .nav-links a:hover{
            color:#58a6ff;
        }

        /* HERO SECTION */

        header{
            height:100vh;
            display:flex;
            flex-direction:column;
            justify-content:center;
            align-items:center;
            text-align:center;
            padding:20px;
            background:linear-gradient(135deg,#0d1117,#161b22);
        }

        header h1{
            font-size:65px;
            margin-bottom:15px;
        }

        header h2{
            font-size:28px;
            color:#58a6ff;
            margin-bottom:25px;
        }

        header p{
            max-width:800px;
            font-size:18px;
            color:#c9d1d9;
            margin-bottom:30px;
        }

        .hero-buttons{
            display:flex;
            gap:20px;
            flex-wrap:wrap;
            justify-content:center;
        }

        .btn{
            padding:14px 28px;
            background:#238636;
            color:white;
            text-decoration:none;
            border-radius:8px;
            transition:0.3s;
            font-weight:bold;
        }

        .btn:hover{
            background:#2ea043;
            transform:translateY(-3px);
        }

        .btn-secondary{
            background:#21262d;
            border:1px solid #30363d;
        }

        .btn-secondary:hover{
            background:#30363d;
        }

        /* SECTIONS */

        section{
            max-width:1100px;
            margin:auto;
            padding:90px 20px;
        }

        h3{
            font-size:38px;
            margin-bottom:35px;
            color:#58a6ff;
            border-bottom:2px solid #30363d;
            padding-bottom:10px;
        }

        .about{
            font-size:18px;
            color:#c9d1d9;
        }

        /* SKILLS */

        .skills-grid{
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
            gap:25px;
        }

        .skill-card{
            background:#161b22;
            padding:30px;
            border-radius:14px;
            border:1px solid #30363d;
            transition:0.3s;
        }

        .skill-card:hover{
            transform:translateY(-8px);
            border-color:#58a6ff;
        }

  .skill-card h4{
    margin-bottom:20px;
    color:#58a6ff;
    font-size:22px;
    display:flex;
    align-items:center;
    gap:10px;
}
        /* PROJECTS */

        .project{
            background:#161b22;
            padding:30px;
            border-radius:14px;
            border:1px solid #30363d;
            margin-bottom:25px;
            transition:0.3s;
        }

        .project:hover{
            transform:translateY(-8px);
            border-color:#58a6ff;
        }

        .project h4{
            margin-bottom:15px;
            color:#58a6ff;
            font-size:24px;
        }

        /* EXPERIENCE TIMELINE */

        .timeline{
            position:relative;
            margin-top:40px;
        }

        .timeline::before{
            content:'';
            position:absolute;
            left:20px;
            top:0;
            width:4px;
            height:100%;
            background:#58a6ff;
        }

        .timeline-item{
            position:relative;
            margin-bottom:40px;
            padding-left:60px;
        }

        .timeline-item::before{
            content:'';
            position:absolute;
            left:10px;
            top:10px;
            width:22px;
            height:22px;
            background:#58a6ff;
            border-radius:50%;
            border:4px solid #0d1117;
        }

        .timeline-content{
            background:#161b22;
            padding:25px;
            border-radius:14px;
            border:1px solid #30363d;
            transition:0.3s;
        }

        .timeline-content:hover{
            transform:translateY(-5px);
            border-color:#58a6ff;
        }

        .timeline-date{
            color:#58a6ff;
            font-weight:bold;
            font-size:15px;
        }

        .timeline-content h4{
            margin-top:10px;
            margin-bottom:10px;
            font-size:24px;
            color:#ffffff;
        }

        .timeline-content h5{
            margin-bottom:15px;
            color:#8b949e;
            font-size:16px;
        }

